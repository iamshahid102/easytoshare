# Copy to `.env.local` and adjust. Next.js loads `.env*` from the project root.

# Storage: auto | memory | mongo
# "auto" uses MongoDB when MONGODB_URI is set, otherwise the in-memory store.
STORE_DRIVER=auto
MONGODB_URI=

# Room lifetime in minutes for the anonymous tier (sliding: refreshed on access)
ROOM_TTL_MINUTES=30

# Room scope: auto | ip | subnet
#   auto   - private/loopback IPs collapse to their LAN prefix (default); public
#            IPs stay exact. Lets devices on one router share a bucket.
#   ip     - exact IP only (the original service's behaviour)
#   subnet - always collapse to /24 (v4) or /64 (v6)
ROOM_SCOPE=auto

# Tier caps (anonymous tier mirrors the live service)
MAX_FILES=2
MAX_FILE_SIZE_MB=5
MAX_TEXT_LENGTH=200000

# Secret used to HMAC client IPs (never store raw IPs)
IP_HASH_SECRET=change-me-in-production

# Number of reverse proxies in front of the app (1 = a single nginx/Vercel-style
# edge that reports the real visitor in X-Forwarded-For)
TRUST_PROXY_HOPS=1

# Rate limiting (per room, per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240

# How often expired rooms are swept
SWEEP_INTERVAL_MS=60000

# Optional: point the browser client at an API on another origin.
# Leave empty to use the built-in same-origin /api routes.
NEXT_PUBLIC_API_URL=
